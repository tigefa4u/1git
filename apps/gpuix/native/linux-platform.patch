+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+impl CloseProtection {
+    fn allow_close(&self) -> bool {
+        let mut state = self.0.lock().unwrap();
+        if state.0 { state.1 = true; }
+        !state.0
+    }
+}
+
+/// The GPUI text system and the compositor's color scheme both live on the UI
+/// thread, while `get_font_families` and `get_system_appearance` are called
+/// from the Node thread. `Arc<Mutex<_>>` carries them across that boundary.
+#[cfg(not(target_os = "macos"))]
+pub struct DesktopState {
+    text_system: Mutex<Option<Arc<gpui::TextSystem>>>,
+    appearance: Mutex<gpui::WindowAppearance>,
+}
+
+#[cfg(not(target_os = "macos"))]
+impl Default for DesktopState {
+    fn default() -> Self {
+        Self {
+            text_system: Mutex::new(None),
+            appearance: Mutex::new(gpui::WindowAppearance::Light),
+        }
+    }
+}
+
+/// Non-macOS hosts enumerate through the GPUI text system: the same catalog a
+/// font lookup resolves against, so the picker lists families that resolve.
+#[cfg(not(target_os = "macos"))]
+pub(crate) fn all_font_families(state: &DesktopState) -> Vec<String> {
+    state
+        .text_system
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|system| system.all_font_names())
+        .unwrap_or_default()
+}
